# Copy to deploy/.env and fill in. Never commit the real file.

# Image tag to run, e.g. sha-1a2b3c4 (no default on purpose)
TAG=

# Postgres container
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Built from the three values above, host is the compose service "postgres":
# postgres://<user>:<password>@postgres:5432/<db>?sslmode=disable
DATABASE_URL=

# pr0gramm account the bot logs in with
PR0_USER=
PR0_PASSWORD=

# Comma-separated pr0gramm usernames the bot ignores
BANNED_USERS=

# Only for a one-off `import-legacy` run; leave empty otherwise
LEGACY_DATABASE_URL=

# Override the pr0gramm API root (testing only); empty means production
PR0_BASE_URL=

# NOTE: every Go service (migrate, bot, api) reads ALL of this file via
# env_file. Do not put the OAuth client secret here, it lives in web.env.

# Shared secret between api and web, at least 32 chars: openssl rand -hex 32
# Same value as INTERNAL_API_TOKEN in web.env
INTERNAL_API_TOKEN=

# pr0gramm name of the admin, e.g. Helix
ADMIN_PR0_NAME=
